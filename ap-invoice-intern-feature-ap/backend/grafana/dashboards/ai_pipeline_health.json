      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(extraction_confidence_score_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}} Median Confidence",
          "range": true,
          "refId": "A"
        }
      ]
