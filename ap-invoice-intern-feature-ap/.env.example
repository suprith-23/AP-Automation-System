# ==========================================
# PostgreSQL Database Configuration
# ==========================================

# PostgreSQL username
POSTGRES_USER=postgres

# PostgreSQL password
POSTGRES_PASSWORD=postgres

# PostgreSQL database name
POSTGRES_DB=ap_db


# ==========================================
# FastAPI Backend Configuration
# ==========================================

# Database connection URL
# Uses Docker service name "postgres"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ap_db

# Backend application port
BACKEND_PORT=8000


# ==========================================
# Next.js Frontend Configuration
# ==========================================

# Frontend application port
FRONTEND_PORT=3000

# Backend API URL for frontend access
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# ==========================================
# pgAdmin Configuration
# ==========================================

# pgAdmin login email
PGADMIN_DEFAULT_EMAIL=admin@ap.com

# pgAdmin login password
PGADMIN_DEFAULT_PASSWORD=admin


# ==========================================
# External AI Services Configuration
# ==========================================

# Hugging Face API Key for Serverless Inference / Router API
HF_TOKEN=your_huggingface_token_here
HF_API_KEY=your_huggingface_api_key_here

# Google Gemini API key (alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------
# AI Models Configuration (Fallback Chain)
# ---------------------------------------------------------
# Add this variable to route all extraction requests to your remote Google Colab server via ngrok (bypasses rate limits)
REMOTE_COLAB_URL=https://<your-ngrok-id>.ngrok-free.app/generate

# Configure your primary AI keys here
GROQ_API_KEY=your_groq_api_key_here

# Nvidia NIM API Key
NVIDIA_API_KEY=your_nvidia_api_key_here

# LLM Fallback Configuration
LLM_PROVIDER_ORDER=nvidia,groq,gemini,huggingface
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.5-flash
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct


# API Endpoint URLs
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
HF_API_URL=https://router.huggingface.co/v1/

# ==========================================
# OCR & Document Processing Configuration
# ==========================================

# Target language for EasyOCR reader initialization
OCR_LANGUAGE=en

# Maximum image width for preprocessing auto-resizing
MAX_IMAGE_WIDTH=1500

# Average confidence threshold below which image preprocessing is triggered
OCR_CONFIDENCE_THRESHOLD=0.3

# Thread pool worker count for multi-page PDF processing
NUMBER_OF_PARALLEL_WORKERS=4

# ==========================================
# Security & Token Configurations
# ==========================================

# Application deployment environment (production, development, testing)
APP_ENV=development

# JWT signing secret key (MUST be set to a secure unique 32+ character random string before booting)
JWT_SECRET=your_secure_random_jwt_secret_here_change_me_in_production

# ==========================================
# MinIO Object Storage Configuration
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# Bootstrap Super Admin Credentials
# ==========================================
INITIAL_SUPERADMIN_EMAIL=nithin.super@company.com
INITIAL_SUPERADMIN_PASSWORD=Password123!


# ==========================================
# Odoo Community Edition Integration
# ==========================================
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USER=admin@company.com
ODOO_API_KEY=your_odoo_api_key_here

# ==========================================
# Mock IMAP Email Ingestion (GreenMail)
# ==========================================
IMAP_SERVER=greenmail
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USE_SSL=false
IMAP_USER=invoices
IMAP_PASSWORD=Password123
SMTP_USER=invoices@company-ap.com
SMTP_PASSWORD=Password123
SCHED_EMAIL_POLLING=5

# ==========================================
# Resend Email Integration
# ==========================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_EMAIL=no-reply@ap-autoflow.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# ==========================================
# WhatsApp Integration (Meta Graph API)
# ==========================================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=ap_whatsapp_verify_token_123
WHATSAPP_APP_SECRET=your_whatsapp_meta_app_secret_here
WHATSAPP_API_VERSION=v20.0

# ==========================================
# Brevo Inbound Email Webhook
# ==========================================
BREVO_INBOUND_DOMAIN=reply.ap-autoflow.com
BREVO_INBOUND_WEBHOOK_TOKEN=brevo_inbound_webhook_token_secret_123



# ==========================================
# Standardized Testing Stack Configuration
# ==========================================

# Testing Mode Indicator
TESTING=false
TEST_DATABASE_URL=sqlite:///./test.db
TEST_BASE_URL=http://localhost:8000/api/v1

# Testcontainers (e.g. for PostgreSQL, MinIO, GreenMail testing)
TESTCONTAINERS_POSTGRES_IMAGE=postgres:15-alpine
TESTCONTAINERS_MINIO_IMAGE=minio/minio:latest

# Playwright End-to-End Testing
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Schemathesis API Contract Testing
SCHEMATHESIS_BASE_URL=http://localhost:8000

# AI/OCR Regressions Datasets
GOLDEN_DATASET_PATH=testing/datasets/golden_dataset.json
OCR_CORPUS_PATH=testing/datasets/ocr_corpus/

# Security & Compliance Testing (OWASP ZAP)
ZAP_TARGET_URL=http://localhost:8000

# Performance & Load Testing (Locust/k6)
LOAD_TEST_BASE_URL=http://localhost:8000

# ==========================================
# GreenMail Mock Email Server
# ==========================================
GREENMAIL_OPTS=-Dgreenmail.setup.test.all -Dgreenmail.users=invoices:Password123@company-ap.com -Dgreenmail.startup.timeout=10000 -Dgreenmail.hostname=0.0.0.0 -Dgreenmail.api.hostname=0.0.0.0
